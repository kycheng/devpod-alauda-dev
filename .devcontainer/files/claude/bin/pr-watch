#!/usr/bin/env python3
"""Watch a GitLab merge request and exit only when something needs attention.

Usage:
  pr-watch <mr-url> --once          print one status line and exit
  pr-watch <mr-url> [--interval S] [--timeout S]   block until an event

Run the blocking form as a background command: the exit is the single wake-up.
Exit codes: 0 event reported, 2 timed out with nothing new, 3 API unreachable.
Reported events are remembered per MR, so re-arming does not repeat them.
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time
import urllib.parse

HOST = os.environ.get("PR_WATCH_HOST", "code.alauda.io")
STATE_DIR = os.path.expanduser("~/.cache/pr-watch")
FAILED = {"failed", "canceled"}
RUNNING = {"pending", "running", "created", "preparing", "waiting_for_resource", "scheduled", "manual"}
MAX_API_FAILURES = 10


def token():
    query = f"protocol=https\nhost={HOST}\n\n"
    try:
        out = subprocess.run(
            ["git", "credential", "fill"], input=query, capture_output=True, text=True, timeout=10
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return ""
    return next((l[9:] for l in out.splitlines() if l.startswith("password=")), "")


def via_devpod(path):
    tok = token()
    if not tok:
        raise RuntimeError("no devpod credential")
    config = f'header = "PRIVATE-TOKEN: {tok}"\n'
    out = subprocess.run(
        ["curl", "-sSf", "--max-time", "30", "--socks5-hostname", "localhost:1080",
         "-K", "-", f"https://{HOST}/api/v4/{path}"],
        input=config, capture_output=True, text=True, timeout=40,
    )
    if out.returncode:
        raise RuntimeError(out.stderr.strip())
    return json.loads(out.stdout)


def via_mac(path):
    remote = f"/opt/homebrew/bin/glab api --hostname {HOST} '{path}'"
    out = subprocess.run(
        ["ssh", "-o", "ConnectTimeout=8", "mac", remote], capture_output=True, text=True, timeout=60
    )
    if out.returncode:
        raise RuntimeError(out.stderr.strip()[-200:])
    return json.loads(out.stdout)


def api(path):
    try:
        return via_devpod(path)
    except (RuntimeError, ValueError, subprocess.SubprocessError):
        return via_mac(path)


def parse_url(url):
    match = re.search(rf"{re.escape(HOST)}/(.+?)/-/merge_requests/(\d+)", url)
    if not match:
        sys.exit(f"not a {HOST} merge request URL: {url}")
    return match.group(1), match.group(2)


def snapshot(group, iid):
    project = "projects/" + urllib.parse.quote(group, safe="")
    mr = api(f"{project}/merge_requests/{iid}")
    latest = {}
    if mr.get("sha"):
        # The API lists newest first; only the newest result per check counts.
        for item in api(f"{project}/repository/commits/{mr['sha']}/statuses?per_page=100"):
            latest.setdefault(item["name"], item)
    return {
        "state": mr.get("state"),
        "sha": (mr.get("sha") or "")[:10],
        "conflicts": bool(mr.get("has_conflicts")),
        "notes": mr.get("user_notes_count", 0),
        "failed": sorted(n for n, s in latest.items() if s["status"] in FAILED),
        "running": sorted(n for n, s in latest.items() if s["status"] in RUNNING),
        "passed": sorted(n for n, s in latest.items() if s["status"] == "success"),
        "links": {n: s.get("target_url") for n, s in latest.items() if s["status"] in FAILED},
    }


def signatures(snap):
    """Conditions worth a wake-up, each named so it fires only once."""
    found = set()
    if snap["state"] != "opened":
        found.add(f"state:{snap['state']}")
    if snap["conflicts"]:
        found.add(f"conflict:{snap['sha']}")
    for name in snap["failed"]:
        found.add(f"failed:{snap['sha']}:{name}")
    if snap["passed"] and not snap["failed"] and not snap["running"]:
        found.add(f"passed:{snap['sha']}")
    return found


def line(snap):
    parts = [f"state={snap['state']}", f"sha={snap['sha']}", f"notes={snap['notes']}",
             f"passed={len(snap['passed'])}", f"running={len(snap['running'])}",
             f"failed={','.join(snap['failed']) or 0}"]
    if snap["conflicts"]:
        parts.append("conflicts=yes")
    return " ".join(parts)


def load_state(path):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(path, state):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(path, "w") as f:
        json.dump(state, f)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("url")
    parser.add_argument("--once", action="store_true")
    parser.add_argument("--interval", type=int, default=120)
    parser.add_argument("--timeout", type=int, default=6 * 3600)
    args = parser.parse_args()
    group, iid = parse_url(args.url)

    if args.once:
        snap = snapshot(group, iid)
        print(line(snap))
        for name, link in snap["links"].items():
            print(f"  {name}: {link}")
        return 0

    state_path = os.path.join(STATE_DIR, re.sub(r"\W+", "_", f"{group}_{iid}") + ".json")
    state = load_state(state_path)
    seen = set(state.get("seen", []))
    notes_seen = state.get("notes")
    deadline = time.time() + args.timeout
    failures = 0
    while time.time() < deadline:
        try:
            snap = snapshot(group, iid)
            failures = 0
        except (RuntimeError, ValueError, OSError, subprocess.SubprocessError) as err:
            failures += 1
            if failures >= MAX_API_FAILURES:
                print(f"API unreachable after {failures} attempts: {err}")
                return 3
            time.sleep(args.interval)
            continue
        if notes_seen is None:
            notes_seen = snap["notes"]
        new = sorted(signatures(snap) - seen)
        if snap["notes"] > notes_seen:
            new.append(f"new-comments:{snap['notes'] - notes_seen}")
        if new:
            save_state(state_path, {"seen": sorted(seen | set(new)), "notes": snap["notes"]})
            print("EVENT " + " ".join(new))
            print(line(snap))
            for name, link in snap["links"].items():
                print(f"  {name}: {link}")
            return 0
        time.sleep(args.interval)
    print("TIMEOUT nothing new; " + line(snap))
    return 2


if __name__ == "__main__":
    sys.exit(main())
