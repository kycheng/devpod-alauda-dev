#!/usr/bin/env bash
# Show long content or design docs to the user on their Mac through a local HTTP server.
#
# Usage: mac-serve <file-or-dir>... [--name <slug>]
#        mac-serve --stop
#
# Copies the files to mac:~/claude-work/serve/<slug>/, renders every .md into a
# same-named .html (marked.js in the browser, raw text if offline), and makes sure one
# python http.server on 127.0.0.1:8765 serves ~/claude-work/serve. Prints the URL to send.
set -euo pipefail
PORT=8765
ROOT='claude-work/serve'
SSH=(ssh -o ConnectTimeout=8 mac)

if [[ "${1:-}" == "--stop" ]]; then
  "${SSH[@]}" "lsof -ti :$PORT | xargs kill 2>/dev/null; echo stopped"
  exit 0
fi

name="" files=()
while (($#)); do
  case "$1" in
    --name) name="$2"; shift 2 ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) files+=("$1"); shift ;;
  esac
done
((${#files[@]})) || { echo "usage: mac-serve <file-or-dir>... [--name <slug>]" >&2; exit 1; }
[[ -n "$name" ]] || name=$(basename "${files[0]}" | sed 's/\.[^.]*$//')
name=$(printf '%s' "$name" | tr -c 'A-Za-z0-9._\n-' '-' | sed 's/^-*//;s/-*$//')
[[ -n "$name" ]] || name="doc-$(date +%m%d%H%M)"

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
cp -r "${files[@]}" "$stage/"
python3 - "$stage" <<'EOF'
import json, os, sys, html
tpl = '''<!doctype html><html lang="zh"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>__TITLE__</title><style>body{max-width:980px;margin:40px auto;padding:0 24px;font:15px/1.7 -apple-system,"PingFang SC",sans-serif;color:#1f2328}
table{border-collapse:collapse;width:100%;margin:12px 0;font-size:14px}th,td{border:1px solid #d0d7de;padding:6px 10px;vertical-align:top}th{background:#f6f8fa}
code{background:#f6f8fa;padding:1px 5px;border-radius:4px}pre{background:#f6f8fa;padding:12px;overflow:auto}pre code{padding:0}
h2{border-bottom:1px solid #d8dee4;padding-bottom:4px;margin-top:32px}
@media(prefers-color-scheme:dark){body{background:#0d1117;color:#e6edf3}th,pre,code{background:#161b22}th,td{border-color:#30363d}h2{border-color:#30363d}}</style>
<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script></head><body><div id="c"></div>
<script>const md=__MD__;document.getElementById("c").innerHTML=window.marked?marked.parse(md):"<pre>"+md.replace(/</g,"&lt;")+"</pre>";</script></body></html>'''
for dirpath, _, names in os.walk(sys.argv[1]):
    for n in names:
        if n.endswith(".md"):
            p = os.path.join(dirpath, n)
            md = open(p, encoding="utf-8").read()
            out = tpl.replace("__TITLE__", html.escape(n[:-3])).replace("__MD__", json.dumps(md, ensure_ascii=False).replace("</", "<\\/"))
            open(p[:-3] + ".html", "w", encoding="utf-8").write(out)
EOF

"${SSH[@]}" "mkdir -p ~/$ROOT/$name"
scp -q -r -o ConnectTimeout=8 "$stage"/. "mac:$ROOT/$name/"
"${SSH[@]}" bash -s <<EOF
cd ~/$ROOT && touch .mac-serve-root
# Restart when the port is free or held by a server rooted somewhere else.
if ! curl -sf -o /dev/null --max-time 3 http://127.0.0.1:$PORT/.mac-serve-root; then
  lsof -ti :$PORT | xargs kill 2>/dev/null || true
  sleep 0.5
  nohup /opt/homebrew/bin/python3 -m http.server $PORT --bind 127.0.0.1 </dev/null >/tmp/mac-serve.log 2>&1 &
  sleep 1
fi
curl -s -o /dev/null --max-time 3 -w '%{http_code}' http://127.0.0.1:$PORT/ | grep -q 200 || { echo "server not answering, see /tmp/mac-serve.log" >&2; exit 1; }
EOF

base="http://127.0.0.1:$PORT/$name/"
for f in "${files[@]}"; do
  b=$(basename "$f")
  if [[ -d "$f" ]]; then echo "$base$b/"
  elif [[ "$b" == *.md ]]; then echo "$base${b%.md}.html"
  else echo "$base$b"; fi
done
echo "mac file: ~/$ROOT/$name/"
