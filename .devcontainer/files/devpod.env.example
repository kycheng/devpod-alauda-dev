# Copy this file to /workspaces/.claude/devpod.env (NOT committed; .gitignore'd)
# and fill in values for your environment. /workspaces/.bashrc auto-sources it
# in every interactive shell.
#
# Used by the `acp-sync-daily` helper and the `acp-kubeconfig-sync` script.

# Daily ACP (rotating)
# Stable redirect URL that 302s to the current daily ACP.
# Replace with your environment's stable entry point.
export ACP_DAILY_ENTRY=http://example.invalid/

# Daily ACP credentials (used as defaults for `acp-kubeconfig-sync`).
# Override per-call with `acp-sync-daily -u <other-user> -p <other-pass>`.
export ACP_DEFAULT_USER=
export ACP_DEFAULT_PASS=

# Default cluster filter for `acp-sync-daily` (passed as --cluster=<name>).
# Leave empty to sync all clusters returned by the registry.
export ACP_DEFAULT_CLUSTER=
