# Copy this file to /workspaces/.claude/devpod.env (NOT committed; .gitignore'd)
# and fill in values for your environment. /workspaces/.bashrc auto-sources it
# in every interactive shell.
#
# Used by the `acp-kubeconfig-sync` script and the SOCKS5 bridge helpers.

# Default ACP login for `acp-kubeconfig-sync`.
# Override per-call with `acp-kubeconfig-sync <url> -u <other-user> -p <other-pass>`.
export ACP_DEFAULT_USER=
export ACP_DEFAULT_PASS=

# SOCKS5 bridge (`bridge-up` / `bridge-route` / `bridge-curl`): ssh host or
# alias of the jump host that can reach your internal network.
export BRIDGE_HOST=
# export BRIDGE_PORT=1080
