#!/usr/bin/env python3
"""
acp-kubeconfig-sync — drop per-cluster kubeconfigs from an ACP into ~/.kube/configs/

Drives the ACP login end-to-end (no kubectl-acp required), then enumerates the
cluster registry on the `global` cluster and writes one kubeconfig per cluster.

Why this exists
  Newer ACP envs (2026+) enforce PKCE on the `alauda-auth` dex client, which
  breaks `kubectl-acp v0.0.7` (password grant gone).  The implicit grant
  (`response_type=id_token token`) is still allowed and needs no client_secret,
  so we ride that.

Usage
  acp-kubeconfig-sync <ACP_URL> [-u USER] [-p PASS]
                                [--out-dir DIR] [--prefix PFX]
                                [--token TOKEN] [--dry-run] [--force]
                                [--cluster NAME ...]

Credentials
  -u / -p default to admin@cpaas.io / 07Apples@ (standard daily-env admin).
  Pass them explicitly to log in as another user.

Override the whole login if you already have a bearer
  --token <jwt>   skips login, uses the token directly. Useful if your ACP
                  issued you a long-lived AccessToken via the UI.

Output
  ~/.kube/configs/<prefix><cluster>.yaml — one self-contained kubeconfig per
  cluster discovered through clusterregistry.k8s.io on the `global` cluster.

  By default <prefix> is auto-derived from the ACP hostname (first subdomain,
  with a trailing `--idp` stripped) plus a `--` separator. So daily's `global`
  lands at `~/.kube/configs/devops-daily-eleqy7--global.yaml` instead of the
  bare `global.yaml`, avoiding collisions across multiple ACPs.

  Override with `--prefix daily-` for a stable short tag, or `--prefix ""` to
  keep the bare cluster name.

Tokens minted by login last ~24h. Re-run this script when they expire.
"""

import argparse, base64, json, os, re, ssl, subprocess, sys, tempfile, time
import urllib.error, urllib.parse, urllib.request
from concurrent.futures import ThreadPoolExecutor
from pathlib import Path

STAMP = "# generated-by: acp-kubeconfig-sync"
CTX = ssl.create_default_context()
CTX.check_hostname = False
CTX.verify_mode = ssl.CERT_NONE


def die(msg, code=1):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(code)


def http(method, url, *, body=None, headers=None, form=None):
    if form is not None:
        body = urllib.parse.urlencode(form).encode()
        headers = {**(headers or {}), "Content-Type": "application/x-www-form-urlencoded"}
    elif isinstance(body, (dict, list)):
        body = json.dumps(body).encode()
        headers = {**(headers or {}), "Content-Type": "application/json"}
    req = urllib.request.Request(url, data=body, method=method, headers=headers or {})
    try:
        with urllib.request.urlopen(req, context=CTX, timeout=30) as r:
            return r.status, r.read().decode(), dict(r.headers)
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode(), dict(e.headers)


def decode_jwt(token):
    try:
        pl = token.split(".")[1]; pl += "=" * (-len(pl) % 4)
        return json.loads(base64.urlsafe_b64decode(pl))
    except Exception:
        return None


def rsa_encrypt_pkcs1(pubkey_pem, payload):
    """RSA-PKCS1v15 encrypt via openssl pkeyutl — stdlib has no RSA."""
    with tempfile.NamedTemporaryFile(delete=False, suffix=".pem") as f:
        f.write(pubkey_pem.encode())
        kp = f.name
    try:
        r = subprocess.run(
            ["openssl", "pkeyutl", "-encrypt", "-pubin", "-inkey", kp,
             "-pkeyopt", "rsa_padding_mode:pkcs1"],
            input=payload, capture_output=True, check=True)
        return base64.b64encode(r.stdout).decode()
    finally:
        os.unlink(kp)


def login(base, user, password):
    """Full dex implicit-grant login. Returns id_token."""
    client_id = "alauda-auth"
    redirect_uri = f"{base}/auth/callback"
    qs = urllib.parse.urlencode({
        "client_id": client_id,
        "response_type": "id_token token",
        "scope": "openid profile email groups offline_access roles ext",
        "redirect_uri": redirect_uri,
        "state": "acp-kubeconfig-sync",
        "nonce": "alauda-console",
    })

    s, b, _ = http("GET", f"{base}/dex/api/v1/authorize?{qs}")
    if s != 200:
        die(f"/dex/api/v1/authorize failed ({s}): {b[:200]}")
    reqtok = json.loads(b).get("req")
    if not reqtok:
        die(f"unexpected authorize body: {b[:200]}")

    s, b, _ = http("GET", f"{base}/dex/pubkey")
    if s != 200:
        die(f"/dex/pubkey failed ({s}): {b[:200]}")
    pk = json.loads(b)

    payload = json.dumps({"ts": pk["ts"], "password": password}).encode()
    try:
        enc = rsa_encrypt_pkcs1(pk["pubkey"], payload)
    except subprocess.CalledProcessError as e:
        die(f"openssl pkeyutl failed: {e.stderr.decode()[:200]}")
    except FileNotFoundError:
        die("openssl not found — install openssl or use --token to skip login")

    s, b, _ = http(
        "POST",
        f"{base}/dex/api/v1/authorize/local?req={reqtok}",
        body={"account": user, "password": enc},
    )
    if s != 200:
        try:
            msg = json.loads(b).get("message", b[:200])
        except Exception:
            msg = b[:200]
        die(f"login failed ({s}): {msg}")

    redirect = json.loads(b).get("redirect_url", "")
    frag = urllib.parse.parse_qs(urllib.parse.urlparse(redirect).fragment)
    id_tok = (frag.get("id_token") or [None])[0]
    if not id_tok:
        die(f"no id_token in redirect_url: {redirect}")
    return id_tok


def list_clusters(base, token):
    paths = [
        "/kubernetes/global/apis/clusterregistry.k8s.io/v1alpha1/clusters",
        "/kubernetes/global/apis/cluster.cpaas.io/v1alpha1/clusters",
    ]
    last = None
    for p in paths:
        s, b, _ = http("GET", f"{base}{p}", headers={"Authorization": f"Bearer {token}"})
        last = (p, s, b)
        if s == 200:
            return p, json.loads(b).get("items", [])
    p, s, b = last
    die(f"could not list clusters via {p} ({s}): {b[:300]}")


def extract_server(text):
    """Pull the `server:` value from a kubeconfig. None if not found."""
    m = re.search(r"^\s*server:\s*(\S+)\s*$", text, re.MULTILINE)
    return m.group(1) if m else None


def extract_token(text):
    """Pull the user `token:` value from a kubeconfig. None if not found."""
    m = re.search(r"^\s+token:\s*(\S+)\s*$", text, re.MULTILINE)
    return m.group(1) if m else None


def probe_server(server, token=None, timeout=5):
    """Probe a recorded API endpoint. Returns (alive, detail).

    alive=False means the kubeconfig is functionally dead and should be
    cleaned up:
      - network-level failure (DNS, TCP, TLS, timeout) -> server gone
      - HTTP 401 -> token expired or revoked; the file can't be used
                    until a fresh sync rewrites it anyway
    Any other HTTP status (200, 403, 404, 5xx, ...) is treated as alive —
    the file may still work for some calls, or transient infra issue.
    """
    headers = {"Authorization": f"Bearer {token}"} if token else {}
    try:
        req = urllib.request.Request(
            f"{server.rstrip('/')}/version", method="GET", headers=headers
        )
        urllib.request.urlopen(req, context=CTX, timeout=timeout).close()
        return True, "ok"
    except urllib.error.HTTPError as e:
        if e.code == 401:
            return False, "http 401"
        return True, f"http {e.code}"
    except (urllib.error.URLError, TimeoutError, OSError, ValueError) as e:
        return False, f"unreachable ({e.__class__.__name__})"


def cleanup_stale(out_dir, dry_run=False):
    """Remove stamped kubeconfigs whose server is unreachable or whose token
    is rejected (HTTP 401).

    Scans the whole out_dir (not scoped to current ACP or --cluster filter)
    so rotated daily envs and decommissioned clusters get swept too. Only
    files we wrote (STAMP header) are eligible — never touches user files.
    """
    candidates = []
    for path in sorted(out_dir.glob("*.yaml")):
        try:
            text = path.read_text(errors="ignore")
        except OSError:
            continue
        if not text.startswith(STAMP):
            continue
        server = extract_server(text)
        if not server:
            continue
        candidates.append((path, server, extract_token(text)))

    if not candidates:
        return 0

    print(f"cleanup: probing {len(candidates)} existing kubeconfig(s)", file=sys.stderr)
    with ThreadPoolExecutor(max_workers=8) as pool:
        results = list(pool.map(lambda x: probe_server(x[1], x[2]), candidates))

    removed = 0
    for (path, server, _), (alive, detail) in zip(candidates, results):
        if alive:
            continue
        if dry_run:
            print(f"  would remove {path.name} ({detail}: {server})", file=sys.stderr)
            removed += 1
            continue
        try:
            path.unlink()
        except OSError as e:
            print(f"  could not remove {path.name}: {e}", file=sys.stderr)
            continue
        print(f"  removed {path.name} ({detail}: {server})", file=sys.stderr)
        removed += 1
    return removed


def derive_acp_slug(base):
    """First hostname segment with a trailing `--idp` stripped (daily IdP marker)."""
    host = urllib.parse.urlparse(base).hostname or ""
    first = host.split(".", 1)[0]
    if first.endswith("--idp"):
        first = first[: -len("--idp")]
    return first


def render_kubeconfig(cluster_name, server, token):
    return (
        f"{STAMP} at {time.strftime('%Y-%m-%dT%H:%M:%S%z')}\n"
        f"apiVersion: v1\n"
        f"kind: Config\n"
        f"clusters:\n"
        f"- cluster:\n"
        f"    insecure-skip-tls-verify: true\n"
        f"    server: {server}\n"
        f"  name: {cluster_name}\n"
        f"contexts:\n"
        f"- context:\n"
        f"    cluster: {cluster_name}\n"
        f"    user: {cluster_name}\n"
        f"  name: {cluster_name}\n"
        f"current-context: {cluster_name}\n"
        f"users:\n"
        f"- name: {cluster_name}\n"
        f"  user:\n"
        f"    token: {token}\n"
    )


def main():
    ap = argparse.ArgumentParser(
        prog="acp-kubeconfig-sync",
        description="Auto-login to an ACP and drop per-cluster kubeconfigs into ~/.kube/configs/",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    ap.add_argument("acp_url",
                    help="e.g. https://devops-daily-eleqy7--idp.alaudatech.net")
    ap.add_argument("-u", "--user", default="admin@cpaas.io",
                    help="ACP username (default: %(default)s)")
    ap.add_argument("-p", "--password", default="07Apples@",
                    help="ACP password (default: %(default)s)")
    ap.add_argument("--token", help="skip login; use this bearer token directly")
    ap.add_argument("--out-dir", default=str(Path.home() / ".kube" / "configs"))
    ap.add_argument("--prefix", default=None,
                    help="prepend to each kubeconfig filename. "
                         "Default: auto-derived from ACP hostname (e.g. "
                         "'devops-daily-eleqy7--'). Pass '' to disable, or "
                         "a custom string like 'daily-'.")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--force", action="store_true",
                    help="overwrite kubeconfigs that weren't written by this script")
    ap.add_argument("--no-cleanup", action="store_true",
                    help="skip the pre-sync probe; by default we remove "
                         "stamped kubeconfigs whose servers are unreachable "
                         "or whose tokens are rejected (HTTP 401)")
    ap.add_argument("--cluster", action="append", default=[], metavar="NAME",
                    help="only sync this cluster (repeat or comma-separate for multiple)")
    args = ap.parse_args()

    wanted = {n.strip() for raw in args.cluster for n in raw.split(",") if n.strip()}

    base = args.acp_url.rstrip("/")

    if args.prefix is None:
        slug = derive_acp_slug(base)
        prefix = f"{slug}--" if slug else ""
        if prefix:
            print(f"prefix: auto -> '{prefix}' (from {base})", file=sys.stderr)
    else:
        prefix = args.prefix

    out_dir = Path(args.out_dir).expanduser()
    out_dir.mkdir(parents=True, exist_ok=True)

    if not args.no_cleanup:
        cleanup_stale(out_dir, dry_run=args.dry_run)

    if args.token:
        token, src = args.token.strip(), "--token"
    else:
        print(f"login: {args.user}  ({base})", file=sys.stderr)
        token = login(base, args.user, args.password)
        src = "implicit-flow"

    claims = decode_jwt(token)
    if claims:
        exp = claims.get("exp")
        hrs = f"{(exp - time.time())/3600:.1f}h" if exp else "—"
        print(f"token: src={src}, email={claims.get('email','?')}, "
              f"exp_in={hrs}, typ={claims.get('typ','id_token')}", file=sys.stderr)

    api_path, items = list_clusters(base, token)
    print(f"cluster registry: {api_path} -> {len(items)} cluster(s)", file=sys.stderr)

    if wanted:
        available = {it["metadata"]["name"] for it in items}
        missing = wanted - available
        if missing:
            die(f"requested cluster(s) not found in registry: {', '.join(sorted(missing))}\n"
                f"available: {', '.join(sorted(available))}")
        items = [it for it in items if it["metadata"]["name"] in wanted]
        print(f"filter: --cluster -> {len(items)} cluster(s)", file=sys.stderr)

    written, skipped = 0, 0
    for it in items:
        name = it["metadata"]["name"]
        server = f"{base}/kubernetes/{name}"
        body = render_kubeconfig(name, server, token)
        path = out_dir / f"{prefix}{name}.yaml"

        if path.exists() and not args.force:
            first = path.read_text(errors="ignore").splitlines()[:1]
            if not first or not first[0].startswith(STAMP):
                print(f"  skip {path.name} (exists, not ours — pass --force to overwrite)",
                      file=sys.stderr)
                skipped += 1
                continue

        if args.dry_run:
            print(f"  would write {path}", file=sys.stderr)
        else:
            path.write_text(body)
            print(f"  wrote   {path}", file=sys.stderr)
        written += 1

    verb = "would write" if args.dry_run else "wrote"
    print(f"\n{verb} {written} kubeconfig(s), skipped {skipped}", file=sys.stderr)


if __name__ == "__main__":
    main()
