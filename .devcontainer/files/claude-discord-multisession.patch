diff --git a/tests/await-dev-channels-prompt.test.ts b/tests/await-dev-channels-prompt.test.ts
new file mode 100644
index 0000000..d4c5042
--- /dev/null
+++ b/tests/await-dev-channels-prompt.test.ts
@@ -0,0 +1,88 @@
+import { test, expect, describe, beforeEach, afterEach } from 'bun:test'
+import { spawnSync } from 'child_process'
+import {
+  mkdtempSync, rmSync, mkdirSync, copyFileSync, chmodSync,
+  readFileSync, existsSync,
+} from 'fs'
+import { tmpdir } from 'os'
+import { join } from 'path'
+
+const HELPER = join(import.meta.dir, '..', 'scripts', 'await-dev-channels-prompt.sh')
+const FAKE = join(import.meta.dir, 'fixtures', 'fake-zellij')
+
+let dir: string
+beforeEach(() => { dir = mkdtempSync(join(tmpdir(), 'await-dc-')) })
+afterEach(() => { rmSync(dir, { recursive: true, force: true }) })
+
+interface RunResult {
+  status: number | null
+  log: string
+  stderr: string
+  attachPid: string
+}
+
+// Run the helper with `zellij` resolved to the fake fixture.
+function run(opts: { promptAt: number; timeout?: number }): RunResult {
+  const bin = join(dir, 'bin')
+  mkdirSync(bin, { recursive: true })
+  copyFileSync(FAKE, join(bin, 'zellij'))
+  chmodSync(join(bin, 'zellij'), 0o755)
+
+  const log = join(dir, 'log')
+  const dumps = join(dir, 'dumps')
+  const attachPid = join(dir, 'attach-pid')
+
+  const res = spawnSync(
+    'bash',
+    [HELPER, 'claude-test-abc123def456', String(opts.timeout ?? 30)],
+    {
+      env: {
+        ...process.env,
+        PATH: `${bin}:${process.env.PATH}`,
+        FZ_LOG: log,
+        FZ_DUMPS_FILE: dumps,
+        FZ_PROMPT_AT: String(opts.promptAt),
+        FZ_ATTACH_PID: attachPid,
+      },
+      encoding: 'utf8',
+      timeout: 60_000,
+    },
+  )
+
+  return {
+    status: res.status,
+    log: existsSync(log) ? readFileSync(log, 'utf8') : '',
+    stderr: res.stderr ?? '',
+    attachPid: existsSync(attachPid) ? readFileSync(attachPid, 'utf8').trim() : '',
+  }
+}
+
+describe('await-dev-channels-prompt.sh', () => {
+  test('sends Enter once the dev-channels prompt appears', () => {
+    const { status, log } = run({ promptAt: 2 })
+    expect(status).toBe(0)
+    expect(log).toContain('send-keys Enter')
+  })
+
+  test('exits non-zero when the prompt never appears within the timeout', () => {
+    const { status, log, stderr } = run({ promptAt: 9999, timeout: 2 })
+    expect(status).not.toBe(0)
+    expect(log).not.toContain('send-keys')
+    expect(stderr).toContain('not seen in 2s')
+  })
+
+  test('reaps its transient client on exit', () => {
+    const { attachPid } = run({ promptAt: 1 })
+    expect(attachPid).not.toBe('')
+
+    // The transient client must be gone shortly after the helper returns.
+    // Poll up to ~2s to absorb SIGTERM delivery latency.
+    const pid = Number(attachPid)
+    let alive = true
+    for (let i = 0; i < 20; i++) {
+      try { process.kill(pid, 0) } catch { alive = false; break }
+      Bun.sleepSync(100)
+    }
+    expect(alive).toBe(false)
+  })
+})
