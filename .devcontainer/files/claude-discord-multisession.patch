new file mode 100755
index 0000000..23ed1c1
--- /dev/null
+++ b/scripts/await-dev-channels-prompt.sh
@@ -0,0 +1,73 @@
+#!/usr/bin/env bash
+# Wait for the `claude --dangerously-load-development-channels` prompt to
+# render in a launched zellij session, then send Enter to dismiss it.
+#
+# `zellij action` only delivers to a session that has at least one client
+# attached. The launch flow creates the session detached (zellij attach
+# --create-background) and never attaches a client, so this helper
+# attaches a transient pty-backed client via script(1) for the duration of
+# the Enter delivery, then reaps it.
+#
+# Usage: await-dev-channels-prompt.sh <session_name> [timeout_seconds]
+# Exit:  0 once Enter has been sent; non-zero on timeout.
+set -euo pipefail
+
+session="${1:?usage: await-dev-channels-prompt.sh <session_name> [timeout_seconds]}"
+timeout="${2:-30}"
+
+sentinel="I am using this for local development"
+tmp=""
+client_pid_file=""
+client_pgid=""
+
+cleanup() {
+  rm -f "$tmp" "$client_pid_file"
+  if [ -n "$client_pgid" ]; then
+    # Reap the whole process group of the transient client. script(1) creates
+    # a new process group for its child (zellij-attach), so we track the inner
+    # PID via client_pid_file and kill by that process group.
+    kill -TERM "-${client_pgid}" 2>/dev/null || true
+  fi
+}
+trap cleanup EXIT
+
+tmp="$(mktemp)"
+client_pid_file="$(mktemp)"
+
+# Attach a transient pty-backed client so `zellij action` has a client to
+# deliver to. We wrap the zellij invocation in a bash -c that records its
+# own PID (= the PGID that script(1) assigns to its child) before exec'ing
+# zellij, so cleanup can reliably reap zellij-attach and any descendants.
+SHELL=/bin/bash setsid script -qfc \
+  "bash -c 'echo \$\$ > ${client_pid_file}; exec env -u ZELLIJ -u ZELLIJ_SESSION_NAME zellij attach ${session}'" \
+  /dev/null >/dev/null 2>&1 &
+
+# Wait briefly for the wrapper to record the inner PID, then use it as
+# the process group to kill on exit.
+for _i in $(seq 20); do
+  if [ -s "$client_pid_file" ]; then
+    # The recorded value is the inner process PID, which equals its PGID
+    # because script(1) places its child in a new process group.
+    client_pgid="$(cat "$client_pid_file")"
+    break
+  fi
+  sleep 0.1
+done
+if [ -z "$client_pgid" ]; then
+  echo "await-dev-channels-prompt: warning: transient client PID not recorded; it may not be reaped" >&2
+fi
+
+deadline=$(( $(date +%s) + timeout ))
+while [ "$(date +%s)" -lt "$deadline" ]; do
+  env -u ZELLIJ -u ZELLIJ_SESSION_NAME \
+    zellij -s "$session" action dump-screen --path "$tmp" 2>/dev/null || true
+  if grep -q "$sentinel" "$tmp" 2>/dev/null; then
+    env -u ZELLIJ -u ZELLIJ_SESSION_NAME \
+      zellij -s "$session" action send-keys "Enter"
+    exit 0
+  fi
+  sleep 0.5
+done
+
+echo "await-dev-channels-prompt: '${sentinel}' not seen in ${timeout}s for session '${session}'" >&2
+exit 1
