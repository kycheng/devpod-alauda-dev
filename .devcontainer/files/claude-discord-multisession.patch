+/**
+ * Delete a single binding entry, preserving everything else on disk.
+ *
+ * Same per-file critical-section discipline as `upsertBinding` /
+ * `migrateBindingKey`: load-modify-write inside the queued lock so a parallel
+ * upsert cannot resurrect the entry we just deleted (or vice versa). No-op
+ * (resolved promise) when the file or entry is absent — callers can fire and
+ * forget on cleanup paths without having to probe first.
+ */
+export function removeBinding(file: string, sessionId: string): Promise<void> {
+  return enqueue(file, () => {
+    const current = loadBindings(file)
+    if (!(sessionId in current)) return
+    delete current[sessionId]
+    writeAtomic(file, JSON.stringify(current, null, 2) + '\n')
+  })
+}
