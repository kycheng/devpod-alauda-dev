+import { test, expect, describe } from 'bun:test'
+import { readFileSync } from 'fs'
+import { join } from 'path'
+
+const SKILL = readFileSync(
+  join(import.meta.dir, '..', 'skills', 'launch', 'SKILL.md'),
+  'utf8',
+)
+
+describe('launch SKILL.md — discord_ask confirmation gates', () => {
+  test('allowed-tools lists the await-dev-channels-prompt helper', () => {
+    expect(SKILL).toContain(
+      'Bash(/workspaces/claude-discord-multisession/scripts/await-dev-channels-prompt.sh *)',
+    )
+  })
+
+  test('start has a Discord-triggered launch confirmation (step 1A)', () => {
+    expect(SKILL).toContain('1A.')
+    // 1A must live in the `start` section and have discord_ask near it
+    expect(SKILL).toMatch(/###\s+`start[\s\S]{0,2000}1A\.[\s\S]{0,500}discord_ask/)
+  })
+
+  test('step 8 calls the helper and the old action write 13 is gone', () => {
+    expect(SKILL).toContain('await-dev-channels-prompt.sh "$session"')
+    expect(SKILL).not.toContain('action write 13')
+  })
+
+  test('stop has a Discord-triggered confirmation gate', () => {
+    expect(SKILL).toMatch(/###\s+`stop[\s\S]{0,400}discord_ask/)
+  })
+
+  test('step 3 binding-conflict uses the same discord trust gate', () => {
+    // Guards against discord_ask being removed from step 3 entirely;
+    // wording changes within step 3 are intentionally not asserted.
+    expect(SKILL).toMatch(/has_inplace[\s\S]{0,500}discord_ask/)
+  })
+})
