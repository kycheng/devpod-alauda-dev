+    writeFrame(sock, { type: 'register', id: 1, session_id: 'sess-recreate', mode: 'thread', cwd: '/repo/my-app', thread_id: 'auto' })
+    const ack = await recv(it)
+    expect(ack.type).toBe('register_ack')
+    const oldThread = ack.thread_id as string
+    expect(oldThread).toMatch(/^fake-thread-/)
+
+    // Sanity: an inbound on the old thread reaches the shim.
+    daemon!.deliverInbound!({
+      chat_id: oldThread, message_id: 'm1', user: 'alice', user_id: 'u1',
+      ts: '2026-01-01T00:00:00Z', content: 'before delete', isDM: false, parentChannelId: 'parent-1',
+      hasBotMention: false, isReplyToBot: false, attachments: [],
+    })
+    expect((await recv(it)).content).toBe('before delete')
+
+    // Simulate the gateway threadDelete event.
+    await daemon!.handleThreadDeleted!(oldThread)
+
+    // Expect: createThread called a second time under the same parent.
+    const creates = ops.calls.filter(c => c.kind === 'createThread')
+    expect(creates).toHaveLength(2)
+    const newThread = creates[1].thread_id as string
+    expect(newThread).not.toBe(oldThread)
+
+    // Onboarding reply posted in the new thread.
+    const onboardingReply = ops.calls.find(c => c.kind === 'reply' && c.chat_id === newThread) as any
+    expect(onboardingReply).toBeTruthy()
+    expect(onboardingReply.text).toMatch(/Previous thread was deleted/)
+    expect(onboardingReply.text).toContain(oldThread)
+    expect(onboardingReply.text).toContain('/repo/my-app')
+
+    // bindings.json now points at the new thread for the same session.
+    const onDisk = loadBindings(join(dir, 'bindings.json'))
+    expect(onDisk['sess-recreate'].thread_id).toBe(newThread)
+    expect(onDisk['sess-recreate'].cwd).toBe('/repo/my-app')
+
+    // Inbound on the new thread routes to the same shim — proves threadIndex
+    // was rewired without re-registering.
+    daemon!.deliverInbound!({
+      chat_id: newThread, message_id: 'm2', user: 'alice', user_id: 'u1',
+      ts: '2026-01-01T00:00:01Z', content: 'after recreate', isDM: false, parentChannelId: 'parent-1',
+      hasBotMention: false, isReplyToBot: false, attachments: [],
+    })
+    expect((await recv(it)).content).toBe('after recreate')
+
+    // The redirect: a tool call that still carries the dead snowflake (Claude
+    // pulled it from pre-deletion transcript) is rewritten to the new thread.
+    writeFrame(sock, { type: 'tool_call', id: 99, name: 'reply', args: { chat_id: oldThread, text: 'using stale id' } })
+    const toolResult = await recv(it)
+    expect(toolResult.type).toBe('tool_result')
+    expect(toolResult.isError).toBeUndefined()
+    const stalePathReply = ops.calls.find(c => c.kind === 'reply' && c.text === 'using stale id') as any
+    expect(stalePathReply).toBeTruthy()
+    expect(stalePathReply.chat_id).toBe(newThread)  // rewritten, not oldThread
+  })
+
+  // Defensive path: parent unset. Daemon can't recreate without a parent, so
+  // it should drop the binding cleanly (next launch with thread_id=auto sees
+  // no binding → creates a fresh thread). Locks the "don't leave a stale
+  // binding on disk pointing at a dead thread" invariant.
+  test('drops binding when parentChannelId is unset', async () => {
+    const ops = new FakeDiscordOps()
+    const { saveAccess, defaultAccess } = await import('../src/access')
+    const { saveBindings, loadBindings } = await import('../src/bindings')
+    saveAccess(join(dir, 'access.json'), defaultAccess())
+    await saveBindings(join(dir, 'bindings.json'), {
+      'sess-orphan': { thread_id: 'dead-thread', cwd: '/x', created_at: 1, last_seen_at: 2 },
+    })
+
+    daemon = await startDaemon({ stateDir: dir, ops, idleExitMs: 60_000 })
+    // Seed threadIndex by faking a register flow is overkill here — the
+    // handler reads threadIndex synchronously. We can't reach the in-daemon
+    // map from outside, so register a real thread session and then simulate
+    // its deletion below. (Without parentChannelId set we can't register a
+    // thread, so set it just for register, then clear and re-load.)
+    const a2 = defaultAccess()
+    a2.parentChannelId = 'parent-1'
+    a2.groups['parent-1'] = { requireMention: false, allowFrom: [] }
+    saveAccess(join(dir, 'access.json'), a2)
+
+    const sock = await connect(join(dir, 'daemon.sock'))
+    const it = frameIterator(sock)
+    writeFrame(sock, { type: 'register', id: 1, session_id: 's-parentless', mode: 'thread', cwd: '/x', thread_id: 'auto' })
+    const ack = await recv(it)
+    expect(ack.type).toBe('register_ack')
+    const threadId = ack.thread_id as string
+
+    // Clear parentChannelId after the register, before invoking the handler.
+    saveAccess(join(dir, 'access.json'), defaultAccess())
+
+    await daemon!.handleThreadDeleted!(threadId)
+
+    // No second createThread call — recreate was skipped.
+    expect(ops.calls.filter(c => c.kind === 'createThread')).toHaveLength(1)
+    // Binding was dropped so the next launch can start fresh.
+    expect(loadBindings(join(dir, 'bindings.json'))['s-parentless']).toBeUndefined()
+  })
+
+  // Unknown thread (no entry in threadIndex). Common case: user deletes some
+  // unrelated thread under the parent channel. Handler should silently no-op.
+  test('no-op when thread is not bound', async () => {
+    const ops = new FakeDiscordOps()
+    daemon = await startDaemon({ stateDir: dir, ops, idleExitMs: 60_000 })
+    await daemon.handleThreadDeleted('never-bound-thread')
+    expect(ops.calls).toEqual([])
+  })
+})
diff --git a/tests/fixtures/fake-zellij b/tests/fixtures/fake-zellij
new file mode 100755
index 0000000..2e71fd8
--- /dev/null
+++ b/tests/fixtures/fake-zellij
@@ -0,0 +1,64 @@
+#!/usr/bin/env bash
+# Deterministic stand-in for `zellij`, used by await-dev-channels-prompt.test.ts.
+# Behavior is driven entirely by environment variables:
+#   FZ_LOG         - if set, append one line per invocation (call trace)
+#   FZ_DUMPS_FILE  - if set, a counter file tracking dump-screen call count
+#   FZ_PROMPT_AT   - the 1-based dump-screen call number from which the
+#                    prompt sentinel is emitted (default 1)
+#   FZ_ATTACH_PID  - if set, the `attach` subcommand writes its PID here
+set -euo pipefail
+
+log() { [ -n "${FZ_LOG:-}" ] && printf '%s\n' "$*" >> "$FZ_LOG" || true; }
+
+# Drop a leading "-s SESSION" so the remaining args start with the verb.
+args=("$@")
+if [ "${args[0]:-}" = "-s" ]; then
+  args=("${args[@]:2}")
+fi
+
+case "${args[0]:-}" in
+  attach)
+    # Simulate a long-lived attached client. Record the PID (which becomes
+    # the `sleep` PID after exec) so the test can assert it is reaped.
+    log "attach ${args[1]:-}"
+    [ -n "${FZ_ATTACH_PID:-}" ] && printf '%s\n' "$$" > "$FZ_ATTACH_PID"
+    exec sleep 600
+    ;;
+  action)
+    case "${args[1]:-}" in
+      dump-screen)
+        # Locate "--path VALUE" among the args.
+        path=""
+        i=0
+        while [ "$i" -lt "${#args[@]}" ]; do
+          if [ "${args[$i]}" = "--path" ]; then
+            path="${args[$((i + 1))]:-}"
+          fi
+          i=$((i + 1))
+        done
+        n=1
+        if [ -n "${FZ_DUMPS_FILE:-}" ]; then
+          n=$(( $(cat "$FZ_DUMPS_FILE" 2>/dev/null || echo 0) + 1 ))
+          printf '%s\n' "$n" > "$FZ_DUMPS_FILE"
+        fi
+        log "dump-screen $n"
+        if [ -n "$path" ]; then
+          if [ "$n" -ge "${FZ_PROMPT_AT:-1}" ]; then
+            printf '%s\n' "I am using this for local development" > "$path"
+          else
+            printf '%s\n' "starting up..." > "$path"
+          fi
+        fi
+        ;;
+      send-keys)
+        log "send-keys ${args[2]:-}"
+        ;;
+      *)
+        log "action-other ${args[*]:-}"
+        ;;
+    esac
+    ;;
+  *)
+    log "other ${args[*]:-}"
+    ;;
+esac
